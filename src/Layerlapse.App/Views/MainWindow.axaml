<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Layerlapse.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
        x:Class="Layerlapse.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="960" Height="600" MinWidth="640" MinHeight="400"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        Title="Layerlapse">

  <Grid ColumnDefinitions="220,*">

    <!-- Sidebar: the printer (opens its connection page), Timelapses, Models (a later milestone). -->
    <Border Grid.Column="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Spacing="2">
          <TextBlock Text="Layerlapse" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
          <Button Command="{Binding ShowPrinterCommand}" Background="Transparent" BorderThickness="0"
                  Padding="0" Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  ToolTip.Tip="Printer connection">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Connection.PrinterTitle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Connection.StateLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Button>
          <ListBox SelectedIndex="{Binding NavIndex}" Background="Transparent">
            <ListBoxItem Content="Timelapses" IsEnabled="{Binding HasTimelapses}" />
            <ListBoxItem Content="Models (coming later)" IsEnabled="False" />
          </ListBox>
        </StackPanel>
        <ToggleSwitch DockPanel.Dock="Bottom" VerticalAlignment="Bottom"
                      IsChecked="{Binding IsLightTheme}"
                      OnContent="Light" OffContent="Dark" />
      </DockPanel>
    </Border>

    <!-- Content -->
    <DockPanel Grid.Column="1">
      <TextBlock DockPanel.Dock="Bottom" Margin="0,0,0,12" HorizontalAlignment="Center" FontSize="12"
                 Text="Unofficial app. Not affiliated with Bambu Lab."
                 Foreground="{DynamicResource TextSecondaryBrush}" />
      <ContentControl Content="{Binding CurrentContent}" />
    </DockPanel>

  </Grid>
</Window>
