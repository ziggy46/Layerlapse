<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Layerlapse.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
        x:Class="Layerlapse.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="960" Height="600" MinWidth="640" MinHeight="400"
        Foreground="{DynamicResource TextBrush}"
        Icon="/Assets/layerlapse.ico"
        Title="Layerlapse">

  <Panel>
    <!-- The window's content. With the XP theme it also draws XP's blue frame and rounded top corners,
         because the system frame is switched off (it leaves a white strip above a custom title bar). -->
    <Border x:Name="Frame" Classes="window-frame">
        <DockPanel>
          <!-- XP-style title bar: shown only with the XP theme on Windows, which hides the system title bar. -->
          <Border x:Name="XpTitleBar" Classes="xp-titlebar" DockPanel.Dock="Top" IsVisible="False"
                  PointerPressed="OnTitleBarPointerPressed" DoubleTapped="OnTitleBarDoubleTapped">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Image Source="/Assets/layerlapse.ico" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="xp-title" Text="Layerlapse">
                <TextBlock.Effect>
                  <DropShadowEffect OffsetX="1" OffsetY="1" BlurRadius="0" Opacity="1" Color="{DynamicResource XpTitleShadowColor}" />
                </TextBlock.Effect>
              </TextBlock>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Classes="xp-caption" Click="OnMinimize" ToolTip.Tip="Minimize">
                  <Path Data="M 0,0 H 7 V 3 H 0 Z" Margin="0,8,2,0" />
                </Button>
                <Button Classes="xp-caption" Click="OnMaximize" ToolTip.Tip="Maximize">
                  <Path Data="M 0,0 H 11 V 11 H 0 Z M 1,3 V 10 H 10 V 3 Z" />
                </Button>
                <Button Classes="xp-caption xp-close" Click="OnClose" ToolTip.Tip="Close">
                  <Path Data="M 0,1 L 1,0 L 4.5,3.5 L 8,0 L 9,1 L 5.5,4.5 L 9,8 L 8,9 L 4.5,5.5 L 1,9 L 0,8 L 3.5,4.5 Z" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="220,*">

            <!-- Sidebar: the printer (opens its connection page), Timelapses, Models, Settings. -->
            <Border Grid.Column="0" Classes="sidebar">
              <DockPanel Margin="12">
              <TextBlock DockPanel.Dock="Bottom" Classes="secondary" FontSize="11" TextWrapping="Wrap"
                         Text="Unofficial app. Not affiliated with Bambu Lab." />
              <StackPanel Spacing="2">
                <TextBlock Text="Layerlapse" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Button Command="{Binding ShowPrinterCommand}" Background="Transparent" BorderThickness="0"
                        Padding="0" Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Classes="sidebar-printer" ToolTip.Tip="Printer connection">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Connection.PrinterTitle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="secondary" Text="{Binding Connection.StateLabel}" />
                  </StackPanel>
                </Button>
                <ListBox SelectedIndex="{Binding NavIndex}" Background="Transparent">
                  <ListBoxItem Content="Timelapses" IsEnabled="{Binding HasTimelapses}" />
                  <ListBoxItem Content="Models" IsEnabled="{Binding HasTimelapses}" />
                  <ListBoxItem Content="Settings" />
                </ListBox>
              </StackPanel>
              </DockPanel>
            </Border>

            <!-- Content -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentContent}" />

          </Grid>
        </DockPanel>
    </Border>

    <!-- XP theme: resize grips on the frame's edges and corners (the system frame is off). -->
    <Panel x:Name="ResizeGrips" IsVisible="False">
      <Border Tag="North" Height="5" VerticalAlignment="Top" Margin="8,0" Background="Transparent" Cursor="TopSide" PointerPressed="OnResizePressed" />
      <Border Tag="South" Height="5" VerticalAlignment="Bottom" Margin="8,0" Background="Transparent" Cursor="BottomSide" PointerPressed="OnResizePressed" />
      <Border Tag="West" Width="5" HorizontalAlignment="Left" Margin="0,8" Background="Transparent" Cursor="LeftSide" PointerPressed="OnResizePressed" />
      <Border Tag="East" Width="5" HorizontalAlignment="Right" Margin="0,8" Background="Transparent" Cursor="RightSide" PointerPressed="OnResizePressed" />
      <Border Tag="NorthWest" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" PointerPressed="OnResizePressed" />
      <Border Tag="NorthEast" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" PointerPressed="OnResizePressed" />
      <Border Tag="SouthWest" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" PointerPressed="OnResizePressed" />
      <Border Tag="SouthEast" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" PointerPressed="OnResizePressed" />
    </Panel>
  </Panel>
</Window>
