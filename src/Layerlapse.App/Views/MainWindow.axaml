<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Layerlapse.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
        x:Class="Layerlapse.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="960" Height="600" MinWidth="640" MinHeight="400"
        Foreground="{DynamicResource TextBrush}"
        Icon="/Assets/layerlapse.ico"
        Title="Layerlapse">

  <!-- XpWindowChrome (code-behind) adds the XP title bar and frame around this with the XP theme. -->
  <Grid ColumnDefinitions="220,*">

    <!-- Sidebar: the printer (opens its connection page), Timelapses, Models, Settings. -->
    <Border Grid.Column="0" Classes="sidebar">
      <DockPanel Margin="12">
      <TextBlock DockPanel.Dock="Bottom" Classes="secondary" FontSize="11" TextWrapping="Wrap"
                 Text="Unofficial app. Not affiliated with Bambu Lab." />
      <StackPanel Spacing="2">
        <TextBlock Text="Layerlapse" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
        <Button Command="{Binding ShowPrinterCommand}" Background="Transparent" BorderThickness="0"
                Padding="0" Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Classes="sidebar-printer" ToolTip.Tip="Printer connection">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Connection.PrinterTitle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="secondary" Text="{Binding Connection.StateLabel}" />
          </StackPanel>
        </Button>
        <ListBox SelectedIndex="{Binding NavIndex}" Background="Transparent">
          <ListBoxItem Content="Timelapses" IsEnabled="{Binding HasTimelapses}" />
          <ListBoxItem Content="Models" IsEnabled="{Binding HasTimelapses}" />
          <ListBoxItem Content="Settings" />
        </ListBox>
      </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content -->
    <ContentControl Grid.Column="1" Content="{Binding CurrentContent}" />

  </Grid>
</Window>
