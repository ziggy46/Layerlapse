<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Layerlapse.App.ViewModels"
             x:Class="Layerlapse.App.Views.TimelapsesView"
             x:DataType="vm:TimelapsesViewModel">

  <DockPanel>
    <!-- Toolbar: title, status, date filter, refresh -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,14">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="Timelapses" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <CalendarDatePicker SelectedDate="{Binding From}" PlaceholderText="From" Width="130" />
          <CalendarDatePicker SelectedDate="{Binding To}" PlaceholderText="To" Width="130" />
          <Button Content="Clear" Command="{Binding ClearFilterCommand}" IsVisible="{Binding IsFiltered}" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsConnected}" />
        </StackPanel>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>
    </Border>

    <!-- Selection and downloads -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,8"
            Background="{DynamicResource PanelBrush}">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Select all" Command="{Binding SelectAllCommand}" />
          <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" IsVisible="{Binding HasSelection}" />
          <Button Classes="accent" Content="{Binding DownloadSelectedLabel}" Command="{Binding DownloadSelectedCommand}"
                  IsVisible="{Binding HasSelection}" FontWeight="Bold" FontSize="14" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowDownloadBar}">
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{Binding DownloadText}" FontSize="12" TextWrapping="Wrap" />
            <ProgressBar Value="{Binding DownloadPercent}" Maximum="100" IsVisible="{Binding IsDownloading}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
            <Button Content="Cancel" Command="{Binding CancelDownloadsCommand}" IsVisible="{Binding IsDownloading}" />
            <Button Content="Show folder" Command="{Binding RevealFolderCommand}" IsVisible="{Binding CanRevealFolder}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Panel>
      <!-- No timelapses at all -->
      <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="6">
        <TextBlock Text="No timelapses on this printer" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="The printer saves a timelapse only when timelapse recording is switched on for a print and storage is inserted." />
      </StackPanel>

      <TextBlock IsVisible="{Binding IsFilteredEmpty}" Text="No timelapses between these dates."
                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />

      <!-- First load -->
      <ProgressBar IsIndeterminate="True" Width="160" VerticalAlignment="Center"
                   IsVisible="{Binding !HasLoaded}" />

      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Items}" Margin="16">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TimelapseItemViewModel">
              <Border Width="220" Margin="4" Background="{DynamicResource CardBrush}"
                      BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <StackPanel>
                  <Panel Height="124" Background="{DynamicResource PanelBrush}">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    <Border Classes="thumb-check" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                      <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" Padding="0" ToolTip.Tip="Select for download" />
                    </Border>
                  </Panel>
                  <StackPanel Margin="10,8,10,10" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               ToolTip.Tip="Duration is approximate: the file's last change minus the start time in its name." />
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Margin="0,6,0,0" IsVisible="{Binding IsDownloading}" />
                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,6,0,0">
                      <Button Content="Play"
                              Command="{Binding $parent[ItemsControl].((vm:TimelapsesViewModel)DataContext).PlayCommand}"
                              CommandParameter="{Binding}" IsEnabled="{Binding IsIdle}" />
                      <Button Content="Download"
                              Command="{Binding $parent[ItemsControl].((vm:TimelapsesViewModel)DataContext).DownloadOneCommand}"
                              CommandParameter="{Binding}" />
                      <Button Content="Delete…" Classes="danger"
                              IsVisible="{Binding $parent[ItemsControl].((vm:TimelapsesViewModel)DataContext).AllowDelete}"
                              Command="{Binding $parent[ItemsControl].((vm:TimelapsesViewModel)DataContext).DeleteCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="Delete this timelapse from the printer (asks first)" />
                    </WrapPanel>
                    <TextBlock Text="{Binding DownloadStatus}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                               IsVisible="{Binding DownloadStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
