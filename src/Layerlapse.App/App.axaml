<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Layerlapse.App.App"
             xmlns:local="using:Layerlapse.App"
             RequestedThemeVariant="Dark">
  <!-- Dark by default; the sidebar toggle switches to Light at runtime. -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Layerlapse/Themes/Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="{StaticResource BrandAccentColor}" />
        <ColorPaletteResources x:Key="Light" Accent="{StaticResource BrandAccentColor}" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Layerlapse/Themes/XpStyles.axaml" />
  </Application.Styles>
</Application>
