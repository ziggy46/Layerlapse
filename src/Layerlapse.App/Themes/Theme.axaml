<!--
  Layerlapse colour tokens. Every colour in the app is defined here, once, per theme variant.
  Views must use {DynamicResource ...} so the light/dark toggle repaints at runtime.

  Token (PLAN.md)  -> resource key
  accent           -> AccentBrush
  accent-hover     -> AccentHoverBrush
  accent-pressed   -> AccentPressedBrush
  background       -> BackgroundBrush
  panel            -> PanelBrush
  card             -> CardBrush
  border           -> LineBrush
  text             -> TextBrush
  text-secondary   -> TextSecondaryBrush
  danger           -> DangerBrush

  Neutrals are approximations until sampled from a real Bambu Studio screenshot.
  White text on accent is ~3:1: only use it for bold labels of 14 px or more.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Same green in both variants. App.axaml feeds it to FluentTheme's palettes so built-in
       controls (selection, toggles, progress) use it instead of the OS accent colour. -->
  <Color x:Key="BrandAccentColor">#00AE42</Color>

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="AccentColor">#00AE42</Color>
      <Color x:Key="AccentHoverColor">#1AC25A</Color>
      <Color x:Key="AccentPressedColor">#009A3A</Color>
      <Color x:Key="BackgroundColor">#1F1F22</Color>
      <Color x:Key="PanelColor">#2D2D31</Color>
      <Color x:Key="CardColor">#38383C</Color>
      <Color x:Key="LineColor">#4A4A50</Color>
      <Color x:Key="TextColor">#F2F2F3</Color>
      <Color x:Key="TextSecondaryColor">#A8A8AF</Color>
      <Color x:Key="DangerColor">#E5484D</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="AccentColor">#00AE42</Color>
      <Color x:Key="AccentHoverColor">#009A3A</Color>
      <Color x:Key="AccentPressedColor">#008A34</Color>
      <Color x:Key="BackgroundColor">#FFFFFF</Color>
      <Color x:Key="PanelColor">#F5F5F5</Color>
      <Color x:Key="CardColor">#FFFFFF</Color>
      <Color x:Key="LineColor">#D8D8D8</Color>
      <Color x:Key="TextColor">#262E30</Color>
      <Color x:Key="TextSecondaryColor">#6B6B6B</Color>
      <Color x:Key="DangerColor">#D13438</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentPressedColor}" />
  <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}" />
  <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />

  <!-- Flat and compact: corner radius 4 or less, 1 px borders. -->
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">4</CornerRadius>
  <Thickness x:Key="LineThickness">1</Thickness>

</ResourceDictionary>
